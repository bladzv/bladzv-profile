# Cloudflare Workers sends these as real HTTP headers on every response.
# Keep this CSP in sync with the meta tag in src/layouts/Layout.astro; the browser enforces both.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' https: data:; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Astro's hashed build files never change, so browsers may cache them for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
