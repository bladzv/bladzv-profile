---
import { getCollection } from 'astro:content';
import { Award, ExternalLink } from '@lucide/astro';

const allCerts = await getCollection('certifications', ({ id }) => !id.startsWith('_'));
const certs = allCerts.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<section id="certifications" class="relative z-10 reveal bg-cyber-surface/40">
  <div class="section-container">
    <div class="flex items-center gap-4 mb-8">
      <div class="w-1 h-7 bg-amber-400 rounded-full flex-shrink-0"></div>
      <div class="flex items-center gap-2.5">
        <Award class="w-5 h-5 text-amber-400" aria-hidden="true" />
        <h2 class="section-heading">Certifications</h2>
      </div>
    </div>

    <div class="grid sm:grid-cols-2 gap-6 max-w-3xl">
      {certs.map((cert) => (
        <div class="glass-card p-6 border-t-2 border-t-amber-400/50 group hover:border-amber-400/40 transition-all duration-300 hover:shadow-[0_0_20px_rgba(245,158,11,0.08)]">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-amber-400/10 border border-amber-400/20 flex items-center justify-center">
              <Award class="w-5 h-5 text-amber-400" />
            </div>
            <div>
              <h3 class="text-base font-semibold text-cyber-text mb-1">{cert.data.name}</h3>
              <p class="text-sm text-cyber-muted">
                {cert.data.issuer} · {cert.data.date}
              </p>
              {cert.data.verify && (
                <a
                  href={cert.data.verify}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Verify ${cert.data.name} certification`}
                  class="inline-flex items-center gap-1 mt-2 text-xs text-cyber-blue hover:text-cyber-green transition-colors font-mono"
                >
                  <ExternalLink class="w-3 h-3" />
                  Verify
                </a>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
