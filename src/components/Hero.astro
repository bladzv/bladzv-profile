---
import { ChevronDown } from '@lucide/astro';
---

<section id="hero" class="relative min-h-screen flex items-center overflow-hidden">
  <div class="section-container relative z-10 w-full">
    <div class="grid md:grid-cols-2 gap-10 lg:gap-20 items-center">

      <!-- Left: Identity -->
      <div>
        <div class="inline-flex items-center gap-2 mb-8 px-3 py-1.5 rounded-full border border-cyber-green/20 bg-cyber-green/5 animate-fade-in" style="animation-delay: 0.2s; opacity: 0;" aria-hidden="true">
          <span class="w-1.5 h-1.5 rounded-full bg-cyber-green animate-glow-pulse"></span>
          <span class="text-xs font-mono text-cyber-green">Open to opportunities</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-7xl font-extrabold font-sans leading-[1.05] mb-8 animate-fade-in-up" style="animation-delay: 0.4s; opacity: 0;">
          <span class="block text-white">Bloodymer</span>
          <span class="block text-gradient">S. Velasco</span>
        </h1>

        <div class="flex flex-wrap gap-3 animate-fade-in" style="animation-delay: 0.8s; opacity: 0;">
          <a href="#projects" class="px-5 py-2.5 bg-cyber-green text-cyber-bg text-sm font-semibold font-sans rounded-lg hover:bg-cyber-green/90 transition-all hover:-translate-y-px">
            View Projects
          </a>
          <a href="#about" class="px-5 py-2.5 border border-cyber-border text-cyber-muted text-sm font-sans rounded-lg hover:border-cyber-green/50 hover:text-white transition-all">
            About Me
          </a>
        </div>
      </div>

      <!-- Right: Terminal card -->
      <div class="animate-fade-in" style="animation-delay: 0.9s; opacity: 0;">
        <div class="glass-card p-5 overflow-hidden">
          <!-- macOS traffic lights -->
          <div class="flex items-center gap-1.5 mb-4 pb-3 border-b border-cyber-border/50" aria-hidden="true">
            <span class="w-2.5 h-2.5 rounded-full bg-red-500/50"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/50"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-green-500/50"></span>
            <span class="ml-3 text-xs font-mono text-cyber-muted">bladzv — bash</span>
          </div>
          <!-- Terminal session -->
          <div class="font-mono text-sm leading-relaxed">
            <div>
              <span class="text-cyber-green select-none">bladzv@kali</span><span class="text-cyber-muted select-none">:</span><span class="text-cyber-blue select-none">~</span><span class="text-cyber-text select-none">$ </span><span class="text-cyber-text">whoami</span>
            </div>
            <div class="text-cyber-muted mb-3">bloodymer.velasco</div>
            <div>
              <span class="text-cyber-green select-none">bladzv@kali</span><span class="text-cyber-muted select-none">:</span><span class="text-cyber-blue select-none">~</span><span class="text-cyber-text select-none">$ </span><span class="text-cyber-text">cat badges.txt</span>
            </div>
            <div class="mb-3 space-y-0.5">
              <div><span class="text-cyber-muted select-none">[</span><span class="text-cyber-green">*</span><span class="text-cyber-muted select-none">]</span> <span class="text-cyber-text">CompTIA Security+</span></div>
              <div><span class="text-cyber-muted select-none">[</span><span class="text-cyber-green">*</span><span class="text-cyber-muted select-none">]</span> <span class="text-cyber-text">Homelab Builder</span></div>
              <div><span class="text-cyber-muted select-none">[</span><span class="text-cyber-green">*</span><span class="text-cyber-muted select-none">]</span> <span class="text-cyber-text">AI-Assisted Dev</span></div>
            </div>
            <!-- Active typing area — fixed 2-line height, overflow clipped: card never shifts -->
            <div class="h-[3.5em] overflow-hidden break-words">
              <span class="text-cyber-green select-none">bladzv@kali</span><span class="text-cyber-muted select-none">:</span><span class="text-cyber-blue select-none">~</span><span class="text-cyber-text select-none">$ </span><span id="typewriter" class="border-r-2 border-cyber-green pr-0.5 text-cyber-text"></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <a href="#about" aria-label="Scroll to About" class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 inline-flex flex-col items-center gap-1 text-cyber-muted hover:text-cyber-green transition-colors animate-fade-in" style="animation-delay: 1.8s; opacity: 0;">
    <span class="text-xs font-mono">scroll</span>
    <ChevronDown class="w-4 h-4 animate-float" />
  </a>

  <!-- Gradient overlay -->
  <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-cyber-bg to-transparent z-10 pointer-events-none"></div>
</section>

<script>
  const phrases = [
    'Aspiring Cybersecurity Professional',
    'Detail-Oriented Problem Solver',
    'Fast Learner & Adaptable',
    'Team Player & Leader',
    'Thrives Under Pressure',
    'Passionate About Security',
  ];

  const el = document.getElementById('typewriter');
  if (el) {
    // Respect user's reduced-motion preference — render static first phrase if set.
    const prefersReduced = typeof window !== 'undefined' && window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) {
      el.textContent = phrases[0];
    } else {
      let phraseIdx = 0;
      let charIdx = 0;
      let deleting = false;

      function tick() {
        const current = phrases[phraseIdx];
        if (!deleting) {
          el!.textContent = current.slice(0, ++charIdx);
          if (charIdx === current.length) {
            deleting = true;
            setTimeout(tick, 1800);
            return;
          }
          setTimeout(tick, 70);
        } else {
          el!.textContent = current.slice(0, --charIdx);
          if (charIdx === 0) {
            deleting = false;
            phraseIdx = (phraseIdx + 1) % phrases.length;
            setTimeout(tick, 400);
            return;
          }
          setTimeout(tick, 40);
        }
      }

      // Wait for the fade-in animation before starting
      setTimeout(tick, 1200);
    }
  }
</script>
