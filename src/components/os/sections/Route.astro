---
import { roles } from '../../../data/profile';
---

<div class="flex max-w-[860px] flex-col gap-1.5 p-[clamp(20px,4%,36px)]">
  <span class="pb-3.5 font-mono text-[13px] text-cyber-muted">~/experience.log · newest first</span>
  <ol>
    {roles.map((r) => (
      <li class="grid grid-cols-[20px_minmax(0,1fr)] gap-4">
        <div class="flex flex-col items-center" aria-hidden="true">
          <span class:list={[
            'mt-[5px] h-3 w-3 shrink-0 rounded-full border-2',
            r.active ? 'border-cyber-green bg-cyber-green shadow-[0_0_10px_rgba(0,255,136,.5)]' : 'border-cyber-border-strong bg-cyber-bg',
          ]}></span>
          <span class="mt-1 w-0.5 flex-1 bg-cyber-border"></span>
        </div>
        <div class="flex min-w-0 flex-col gap-1.5 pb-[26px]">
          <span class:list={['font-mono text-xs', r.active ? 'text-cyber-green' : 'text-cyber-muted']}>{r.period}</span>
          <h3 class="text-[17px] font-bold leading-[1.3] text-white">{r.role}</h3>
          <span class="text-[13px] text-cyber-muted">{r.company}</span>
          <p class="text-sm leading-[1.6] text-cyber-soft">{r.osImpact ?? r.impact}</p>
        </div>
      </li>
    ))}
  </ol>
</div>
