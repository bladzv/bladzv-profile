---
import Layout from '../layouts/Layout.astro';
import OsShell from '../components/os/OsShell.astro';
import { url } from '../lib/paths';

const simpleUrl = url('simple/');
---

<Layout bodyClass="overflow-hidden">
  <script slot="head" is:inline define:vars={{ simpleUrl }}>
    try {
      if (localStorage.getItem('bladzv-mode') === 'simple') location.replace(simpleUrl);
    } catch (e) {}
  </script>
  <noscript>
    <p class="relative z-[2000] bg-cyber-bar p-4 text-center text-sm text-cyber-soft">
      The desktop view needs JavaScript. <a class="text-cyber-green underline" href={simpleUrl}>Read the simple version instead.</a>
    </p>
  </noscript>
  <OsShell />
</Layout>
